# ===== PDFXpress .gitignore =====

# Wordlist (very large file - ~130MB)
rockyou.txt
*.txt

# PDF files (sample/test files)
*.pdf

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Hashcat output
hashcat_found.txt
pdf_hash.txt

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
